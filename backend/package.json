{
  "name": "meta3-4-api-jugadores-rosters-auth",
  "version": "1.0.0",
  "description": "API REST de jugadores y rosters con autorización JWT, cookies y protección CSRF (Meta 3.4)",
  "main": "server.js",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo:all": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [
    "express",
    "rest-api",
    "sequelize",
    "mysql",
    "openapi"
  ],
  "author": "Daniel Gibran Alvarez Armienta",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "googleapis": "^189.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.3"
  }
}
