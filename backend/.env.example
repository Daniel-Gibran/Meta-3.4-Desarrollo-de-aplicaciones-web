# ---------------------------------------------------------------------------
# Plantilla de configuración. Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env
# El archivo .env está en .gitignore: nunca se versiona con credenciales reales.
# ---------------------------------------------------------------------------

# Puerto del servidor Express
PORT=3000

# Origen exacto del frontend (con cookies no se puede usar '*')
CLIENT_URL=http://localhost:5173

# Base de datos MySQL (ejecutar db/setup.sql antes de migrar)
DB_NAME=esports
DB_USER=esports_user
DB_PASSWORD=esports_pass
DB_HOST=127.0.0.1
DB_PORT=3306

# Muestra las consultas SQL en consola. Útil al depurar, ruidoso en la defensa.
DB_LOGGING=false

# Firma del JWT y duración de la sesión
JWT_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# Cookies: duración en milisegundos y política SameSite
COOKIE_MAX_AGE=3600000
COOKIE_SAMESITE=strict

# ---------------------------------------------------------------------------
# Meta 4.1 — Google OAuth 2.0
# Se obtienen en https://console.cloud.google.com/apis/credentials
# La URI de redirección autorizada debe ser exactamente la de abajo.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

